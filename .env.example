# MCP server configuration — copy to .env and fill in.
#
# NEVER commit a filled-in copy. In Azure, supply the secret values as
# Key Vault references, not as a file baked into the image.

# --- The connector (Teams-facing companion service) ------------------
# Base URL of your deployed teams-connector, and the bearer token it
# requires. This service is a client of that one — deploy it first.
CONNECTOR_BASE_URL=https://your-connector-host
# secret — the connector's token, exactly
CONNECTOR_API_TOKEN=

# --- The tool port (what your agent presents) ------------------------
# Your agent presents this bearer token to call the tools — both the
# MCP protocol endpoint (/mcp-server/mcp) and the REST mirror
# (/tools/*). Empty disables the tool surface (503), never opens it.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# secret — REQUIRED for any agent to connect
MCP_TOOLS_TOKEN=

# --- Inbound auth ----------------------------------------------------
# The connector presents this when forwarding a human reply here. Must
# equal the connector's CONNECTOR_INBOUND_TOKEN. Empty disables the
# check — acceptable only on a trusted internal network.
# secret
MCP_INBOUND_TOKEN=

# --- Storage ---------------------------------------------------------
# When using `docker compose up`, IGNORE this: compose assembles the
# URL from the POSTGRES_* values below. Set it only when running the
# service directly against your own database, or as sqlite:///./mcp.db
# for a no-database pilot.
#MCP_DATABASE_URL=postgresql://user:password@host:5432/mcp

# --- Database container (used by docker-compose.yml only) ------------
# secret — REQUIRED for docker compose
POSTGRES_PASSWORD=
POSTGRES_USER=mcp
POSTGRES_DB=mcp
# host port the service is published on
MCP_PORT=8100

# --- The consumer — who receives the humans' answers (pick ONE) ------
# Leave BOTH shapes unset while testing: a built-in mock then records
# deliveries in the log instead of sending them.
#
# Shape 1 — any in-house tool with a callback endpoint. This service
# POSTs {"session_id": "...", "text": "..."} there on every reply:
AGENT_CALLBACK_URL=
# secret — bearer your endpoint expects
AGENT_CALLBACK_TOKEN=
#
# Shape 2 — a SaaS platform with a sessions API (the built-in example
# adapter; see mcp_layer/consumer.py to add another vendor). NOTE: if
# both shapes are set, this one wins.
DEVIN_BASE_URL=
# secret
DEVIN_API_TOKEN=
DEVIN_ORG=

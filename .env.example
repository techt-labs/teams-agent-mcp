# Standalone MCP layer configuration — copy to .env and fill in.
#
# NEVER commit a filled-in copy. In Azure, supply the secret values as
# Key Vault references, not as a file baked into the image.

# --- The connector (Teams-facing service) ----------------------------
# Base URL of the connector service, and the bearer token it requires.
# This layer is a client of the connector.
CONNECTOR_BASE_URL=https://connector.internal
CONNECTOR_API_TOKEN=            # secret — same token the connector expects

# --- The agent platform (Devin) --------------------------------------
# Where a human's answer is delivered. Leave empty to run against the
# built-in mock (records deliveries instead of sending them).
DEVIN_BASE_URL=https://api.devin.example
DEVIN_API_TOKEN=                # secret
DEVIN_ORG=your-org-id

# --- Storage ---------------------------------------------------------
# The session <-> thread table. PostgreSQL for production; SQLite for a
# pilot. Falls back to DATABASE_URL if unset.
MCP_DATABASE_URL=postgresql://user:password@host:5432/mcp
# MCP_DATABASE_URL=sqlite:///./mcp.db

# --- Inbound auth ----------------------------------------------------
# Shared secret the connector presents when forwarding a reply here.
# Must match the connector's CONNECTOR_INBOUND_TOKEN. Empty disables the
# check — acceptable only on a trusted internal network.
MCP_INBOUND_TOKEN=              # secret

# --- Optional default channel ----------------------------------------
# If set, ask_human may be called without a channel and this is used.
# The agent can always override with an explicit channel argument.
FACILITATION_CHANNEL_CONVERSATION_ID=
